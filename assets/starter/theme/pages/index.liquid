{% layout 'base' %}{% block content %}<section class="hero"><p class="eyebrow">{{ site.brand | escape }}</p><h1>{{ site.name | escape }}</h1>{% if site.headline %}<p class="intro">{{ site.headline | escape }}</p>{% endif %}{% if site.extra.intro %}<p>{{ site.extra.intro | escape }}</p>{% endif %}</section>
{% for entry in columns %}{% assign col = entry[1] %}<section><div class="section-heading"><h2>{{ col.name | escape }}</h2><a href="{{ col.url }}">{{ '查看全部' | t: 'View all' }}</a></div><div class="grid">{% for it in col.items limit: 3 %}{% include 'card' %}{% endfor %}</div></section>{% endfor %}{% endblock %}
