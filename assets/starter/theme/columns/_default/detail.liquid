{% layout 'base' %}{% block content %}<article class="detail"><a href="{{ column.url }}">← {{ column.name | escape }}</a><h1>{{ item.title | escape }}</h1>{% if item.summary %}<p class="intro">{{ item.summary | escape }}</p>{% endif %}{% if item.cover %}<img class="cover" src="{{ item.cover | img }}" alt="{{ item.title | escape }}">{% endif %}<div class="body">{{ item.body }}</div>{% if item.fields.size > 0 %}<table>{% for f in item.fields %}<tr><th>{{ f.label | escape }}</th><td>{{ f.value | escape }}</td></tr>{% endfor %}</table>{% endif %}</article>{% endblock %}
