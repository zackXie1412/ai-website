{% layout 'base' %}{% block content %}<article class="narrow detail"><p class="backlink"><a href="{{ column.url }}">← {{ column.name | escape }}</a></p><h1>{{ item.title | escape }}</h1>{% if item.summary %}<p class="lead">{{ item.summary | escape }}</p>{% endif %}{% if item.cover %}<img class="cover" src="{{ item.cover | img }}" alt="{{ item.title | escape }}" loading="lazy">{% endif %}<div class="body">{{ item.body }}</div>{% if item.fields.size > 0 %}<table>{% for f in item.fields %}<tr><th>{{ f.label | escape }}</th><td>{{ f.value | escape }}</td></tr>{% endfor %}</table>{% endif %}</article>{% endblock %}
