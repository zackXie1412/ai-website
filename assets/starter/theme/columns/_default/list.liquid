{% layout 'base' %}{% block content %}<section><h1>{% if category %}{{ category.name | escape }}{% else %}{{ column.name | escape }}{% endif %}</h1><nav class="categories"><a href="{{ column.url }}">{{ '全部' | t: 'All' }}</a>{% for cat in column.categories %}{% if cat.count > 0 %}<a href="{{ cat.url }}">{{ cat.name | escape }}</a>{% endif %}{% endfor %}</nav><div class="grid">{% for it in paginator.items %}{% include 'card' %}{% else %}<p>{{ '内容整理中' | t: 'Content is being prepared' }}</p>{% endfor %}</div><nav class="pagination">{% if paginator.prev_url %}<a href="{{ paginator.prev_url }}">{{ '上一页' | t: 'Previous' }}</a>{% endif %}<span>{{ paginator.page }} / {{ paginator.pages }}</span>{% if paginator.next_url %}<a href="{{ paginator.next_url }}">{{ '下一页' | t: 'Next' }}</a>{% endif %}</nav></section>{% endblock %}
