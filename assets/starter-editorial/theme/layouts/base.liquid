<!doctype html>
<html lang="{{ lang }}"><head>{% include 'yz/seo-head' %}<meta name="viewport" content="width=device-width, initial-scale=1"><link rel="stylesheet" href="{{ 'site.css' | asset_url }}"></head>
<body><header class="site"><div class="wrap bar"><a class="brand" href="{{ home_url }}">{% if site.brand %}{{ site.brand | escape }}{% else %}{{ site.name | escape }}{% endif %}</a><nav class="main" aria-label="{{ '导航' | t: 'Navigation' }}">{% for entry in columns %}<a href="{{ entry[1].url }}">{{ entry[1].name | escape }}</a>{% endfor %}{% for l in langs %}{% unless l.code == lang %}<a href="{{ l.url }}" lang="{{ l.code }}">{{ l.name }}</a>{% endunless %}{% endfor %}</nav><a class="btn small" href="{{ contact_url }}">{{ '联系我们' | t: 'Contact' }}</a></div></header>
<main>{% block content %}{% endblock %}</main>
<footer class="site"><div class="wrap cols"><div><span class="brand">{% if site.brand %}{{ site.brand | escape }}{% else %}{{ site.name | escape }}{% endif %}</span>{% if site.address %}<p>{{ site.address | escape }}</p>{% endif %}{% if site.phone %}<p><a href="tel:{{ site.phone | escape }}">{{ site.phone | escape }}</a></p>{% endif %}{% if site.email %}<p><a href="mailto:{{ site.email | escape }}">{{ site.email | escape }}</a></p>{% endif %}{% if site.whatsapp %}<p>WhatsApp：{{ site.whatsapp | escape }}</p>{% endif %}</div><nav class="main" aria-label="{{ '页脚导航' | t: 'Footer navigation' }}">{% for entry in columns %}<a href="{{ entry[1].url }}">{{ entry[1].name | escape }}</a>{% endfor %}<a href="{{ contact_url }}">{{ '联系我们' | t: 'Contact' }}</a>{% for l in langs %}{% unless l.code == lang %}<a href="{{ l.url }}" lang="{{ l.code }}">{{ l.name }}</a>{% endunless %}{% endfor %}</nav></div><div class="wrap legal"><small>© {{ 'now' | date: '%Y' }} {{ site.name | escape }}</small></div></footer></body></html>
