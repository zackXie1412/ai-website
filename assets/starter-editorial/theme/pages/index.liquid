{% layout 'base' %}{% block content %}
<section class="hero"><div class="wrap hero-grid"><div>{% if site.brand %}<p class="eyebrow">{{ site.brand | escape }}</p>{% endif %}<h1>{{ site.headline | default: site.name | escape }}</h1>{% if site.extra.intro %}<p class="lead">{{ site.extra.intro | escape }}</p>{% endif %}<a class="btn" href="{{ contact_url }}">{{ '获取报价' | t: 'Get a quote' }}</a></div>{% if site.extra.hero %}<div class="pic"><img src="{{ site.extra.hero | img }}" alt="{{ site.name | escape }}" loading="lazy"></div>{% endif %}</div></section>
{% if site.extra.stats %}<section class="stats"><div class="wrap"><div class="row">{% for s in site.extra.stats %}<div class="stat"><strong>{{ s.value | escape }}</strong><span>{{ s.label | escape }}</span></div>{% endfor %}</div></div></section>{% endif %}
{% if site.extra.about %}<section><div class="wrap split"><div><p class="eyebrow">{{ '关于我们' | t: 'About us' }}</p>{% if site.extra.about_title %}<h2>{{ site.extra.about_title | escape }}</h2>{% endif %}<p style="margin-top:20px">{{ site.extra.about | escape }}</p></div>{% if site.extra.about_image %}<div class="pic"><img src="{{ site.extra.about_image | img }}" alt="{{ site.name | escape }}" loading="lazy"></div>{% endif %}</div></section>{% endif %}
{% if site.extra.gallery %}<section style="padding-top:0"><div class="wrap"><div class="strip">{% for g in site.extra.gallery %}<img src="{{ g | img }}" alt="{{ site.name | escape }}" loading="lazy">{% endfor %}</div></div></section>{% endif %}
{% if site.extra.banner and site.extra.banner.image %}{% assign b = site.extra.banner %}<section class="banner"><img src="{{ b.image | img }}" alt="{{ b.text | default: site.name | escape }}" loading="lazy">{% if b.text %}<div class="cap"><div class="wrap"><p>{{ b.text | escape }}</p></div></div>{% endif %}</section>{% endif %}
{% if columns.products and columns.products.count > 0 %}<section><div class="wrap"><div class="shead"><h2>{{ '精选产品' | t: 'Featured products' }}</h2><a href="{{ columns.products.url }}">{{ '查看全部' | t: 'View all' }}</a></div><div class="cards">{% assign picked = '' %}{% for it in columns.products.featured limit: 3 %}{% include 'pcard' %}{% assign picked = picked | append: it.slug | append: ',' %}{% endfor %}{% if columns.products.featured.size < 3 %}{% for it in columns.products.items limit: 3 %}{% unless picked contains it.slug %}{% include 'pcard' %}{% endunless %}{% endfor %}{% endif %}</div></div></section>{% endif %}
{% if site.extra.steps %}<section><div class="wrap"><div class="shead"><h2>{{ '合作流程' | t: 'How we work' }}</h2></div><div class="steps">{% for s in site.extra.steps %}<div class="step"><span class="no">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span><div>{% if s.title %}<h3>{{ s.title | escape }}</h3>{% endif %}{% if s.text %}<p>{{ s.text | escape }}</p>{% endif %}</div></div>{% endfor %}</div></div></section>{% endif %}
{% if columns.news and columns.news.count > 0 %}<section><div class="wrap"><div class="shead"><h2>{{ '新闻动态' | t: 'News' }}</h2><a href="{{ columns.news.url }}">{{ '查看全部' | t: 'View all' }}</a></div><div class="rows">{% for n in columns.news.items limit: 3 %}<article><time>{{ n.date | date_local }}</time><div><h3><a href="{{ n.url }}">{{ n.title | escape }}</a></h3>{% if n.summary %}<p>{{ n.summary | escape }}</p>{% endif %}</div></article>{% endfor %}</div></div></section>{% endif %}
{% if site.extra.certs or site.extra.qualifications %}<section class="certs"><div class="wrap"><div class="shead"><h2>{{ '资质与荣誉' | t: 'Certificates & honors' }}</h2></div>{% if site.extra.certs %}<div class="row">{% for c in site.extra.certs %}<img src="{{ c | img }}" alt="{{ site.name | escape }}" loading="lazy">{% endfor %}</div>{% endif %}{% if site.extra.qualifications %}<ul class="hairline">{% for q in site.extra.qualifications %}<li>{{ q | escape }}</li>{% endfor %}</ul>{% endif %}</div></section>{% endif %}
<section class="cta"><div class="wrap"><h2>{{ '把您的下一个项目交给我们' | t: 'Tell us about your next project' }}</h2><a class="btn" href="{{ contact_url }}">{{ '联系我们' | t: 'Contact us' }}</a></div></section>
{% endblock %}
